{
  "id": "pyro",
  "title": "PYRO",
  "description": "Sistema PYRO",
  "version": "0.2.0",
  "compatibility": {
    "minimum": "13",
    "verified": "13"
  },
  "authors": [
    {
      "name": "Pedro-zar"
    }
  ],
  "esmodules": [
    "module/pyro.mjs"
  ],
  "styles": [
    "styles/tokens.css",
    "styles/pyro.css"
  ],
  "languages": [
    {
      "lang": "pt-BR",
