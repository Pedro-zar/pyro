<section class="tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">
  {{!--
    Duas colunas independentes: redimensionar um bloco só empurra os blocos
    da própria coluna, sem descolar os da coluna vizinha.
  --}}
  <div class="notas-grade">

    <div class="notas-col">
      <div class="bloco">
        <h4 class="titulo-secao">{{localize "PYRO.Notas.Biografia"}}</h4>
        {{formInput systemFields.biografia value=system.biografia enriched=notas.biografia
                    name="system.biografia" toggled=true height=220}}
      </div>

      <div class="bloco">
        <h4 class="titulo-secao">{{localize "PYRO.Notas.Anotacoes"}}</h4>
        {{formInput systemFields.anotacoes value=system.anotacoes enriched=notas.anotacoes
                    name="system.anotacoes" toggled=true height=180}}
      </div>

      <div class="bloco">
        <input class="titulo-livre" type="text" name="system.livre1.titulo"
               value="{{system.livre1.titulo}}"
               placeholder="{{localize 'PYRO.Notas.TituloLivre'}}" />
        {{formInput systemFields.livre1.fields.texto value=system.livre1.texto
                    enriched=notas.livre1 name="system.livre1.texto" toggled=true height=180}}
      </div>
    </div>

    <div class="notas-col">
      {{!-- Crenças e instintos (SRD §11): os pilares do personagem e o que ele
            faz sem precisar dizer. São a fonte dos pontos de Força de Vontade,
            e por isso ficam em campos próprios, não numa anotação solta. --}}
      <div class="bloco tracos-persona">
        <h4 class="titulo-secao">{{localize "PYRO.Persona.Crencas"}}</h4>
        <p class="pyro-nota">{{localize "PYRO.Persona.CrencasDica"}}</p>
        {{#each system.crencas as |c idx|}}
        <input type="text" name="system.crencas.{{idx}}" value="{{c}}"
               placeholder="{{localize 'PYRO.Persona.CrencaPlaceholder'}}" />
        {{/each}}
      </div>

      <div class="bloco tracos-persona">
        <h4 class="titulo-secao">{{localize "PYRO.Persona.Instintos"}}</h4>
        <p class="pyro-nota">{{localize "PYRO.Persona.InstintosDica"}}</p>
        {{#each system.instintos as |i idx|}}
        <input type="text" name="system.instintos.{{idx}}" value="{{i}}"
               placeholder="{{localize 'PYRO.Persona.InstintoPlaceholder'}}" />
        {{/each}}
      </div>

      <div class="bloco">
        <h4 class="titulo-secao">{{localize "PYRO.Notas.Pessoas"}}</h4>
        {{formInput systemFields.pessoas value=system.pessoas enriched=notas.pessoas
                    name="system.pessoas" toggled=true height=180}}
      </div>

      {{#if isNpc}}
      <div class="bloco">
        <h4 class="titulo-secao">{{localize "PYRO.NotasMestre"}}</h4>
        {{formInput systemFields.notas value=system.notas enriched=notas.mestre
                    name="system.notas" toggled=true height=180}}
      </div>
      {{/if}}

      <div class="bloco">
        <input class="titulo-livre" type="text" name="system.livre2.titulo"
               value="{{system.livre2.titulo}}"
               placeholder="{{localize 'PYRO.Notas.TituloLivre'}}" />
        {{formInput systemFields.livre2.fields.texto value=system.livre2.texto
                    enriched=notas.livre2 name="system.livre2.texto" toggled=true height=180}}
      </div>
    </div>
  </div>
</section>
