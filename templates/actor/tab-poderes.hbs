<section class="tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">

  {{#if system.temMagia}}
  <div class="linha-magia">
    <div class="painel painel-magia">
      <div class="magia-numeros">
        {{#if system.afinidadesLista.length}}
        <span><span class="rotulo">{{localize "PYRO.Item.Afinidades"}}</span>
          {{#each system.afinidadesLista as |af|}}
          <strong class="afinidade"{{#if af.cor}} style="color: var(--pyro-el-{{af.cor}})"{{/if}}>{{af.label}}</strong>
          {{/each}}
        </span>
        {{/if}}
        <span><span class="rotulo">{{localize "PYRO.RecuperacaoCena"}}</span>
          <strong class="numero">{{system.recursos.mana.recuperacao}}</strong></span>
      </div>
      <button type="button" class="botao-principal" data-action="abrirConjurador">
        <i class="fa-solid fa-wand-sparkles"></i> {{localize "PYRO.Conjurador.Abrir"}}
      </button>
    </div>
    <button type="button" class="botao-secao so-icone" data-action="criarItem" data-tipos="{{tiposPoderes}}"
            title="{{localize 'PYRO.Criar'}}">
      <i class="fa-solid fa-plus"></i>
    </button>
  </div>
  {{else}}
  {{#if tiposPoderes}}
  <div class="barra-acoes">
    <button type="button" class="botao-secao so-icone" data-action="criarItem" data-tipos="{{tiposPoderes}}"
            title="{{localize 'PYRO.Criar'}}">
      <i class="fa-solid fa-plus"></i>
    </button>
  </div>
  {{/if}}
  {{/if}}

  {{#if system.temMagia}}
  {{> "pyro.secao" secao=secoes.magias}}
  {{> "pyro.secao" secao=secoes.runas}}
  {{/if}}

  {{#if system.temFeiticos}}
  {{> "pyro.secao" secao=secoes.feiticos}}
  {{/if}}

  {{#if system.temAbaCaminho}}
  {{> "pyro.secao" secao=secoes.caminhoProprio}}
  {{/if}}
</section>
