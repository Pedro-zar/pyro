<section class="tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">
  <div class="barra-acoes">
    <p class="pyro-nota">{{localize "PYRO.Pericia.AbaDica"}}</p>
    <button type="button" class="botao-secao so-icone" data-action="criarItem"
            data-type="pericia" title="{{localize 'PYRO.Criar'}}">
      <i class="fa-solid fa-plus"></i>
    </button>
  </div>

  {{> "pyro.secao" secao=secoes.pericias}}
</section>
