<section class="secao secao-{{secao.chave}}">
  <header class="secao-topo">
    <h3 class="titulo-secao">{{secao.titulo}}</h3>
    <span class="secao-contagem numero">{{secao.itens.length}}</span>
  </header>

  {{#if secao.itens.length}}
  {{#unless secao.semLegenda}}
  <div class="secao-legenda grade-linha">
    <span></span>
    <span class="leg-nome">{{secao.colNome}}</span>
    <span class="detalhes">
      {{#each secao.colunas as |c|}}<span class="detalhe {{c.classe}}">{{c.texto}}</span>{{/each}}
    </span>
    <span class="cauda">
      {{#each secao.cauda as |c|}}<span class="detalhe {{c.classe}}">{{c.texto}}</span>{{/each}}
      {{#if secao.legIcones}}<span class="{{secao.legIcones}}"></span>{{/if}}
    </span>
  </div>
  {{/unless}}

  {{#if secao.grupos}}
  {{!-- Seção agrupada (habilidades por caminho): um cabeçalho por grupo, e
        as linhas de cada um já vêm na ordem das vagas de XP. --}}
  {{#each secao.grupos as |grupo|}}
  <div class="grupo-secao">
    <h4 class="grupo-titulo">{{grupo.titulo}}
      <span class="secao-contagem numero">{{grupo.itens.length}}</span></h4>
    <ol class="lista-itens">
      {{#each grupo.itens as |item|}}
      {{> "systems/pyro/templates/actor/partials/item-linha.hbs" linha=item}}
      {{/each}}
    </ol>
  </div>
  {{/each}}
  {{else}}
  <ol class="lista-itens">
    {{#each secao.itens as |item|}}
    {{> "systems/pyro/templates/actor/partials/item-linha.hbs" linha=item}}
    {{/each}}
  </ol>
  {{/if}}
  {{else}}
  <p class="secao-vazia">{{secao.vazio}}</p>
  {{/if}}
</section>
