{{!--
  Atributos ficam fora das abas: são consultados em qualquer contexto de jogo,
  então acompanham o cabeçalho em vez de morar dentro de Combate.
--}}
<div class="painel painel-atributos">
  <div class="grade-atributos">
    {{#each system.atributos as |attr chave|}}
    <div class="atributo {{#if attr.acimaDoLimite}}acima-limite{{/if}}">
      <button type="button" class="rolagem" data-action="rolarAtributo" data-atributo="{{chave}}"
              title="{{localize 'PYRO.RolarTooltip'}}">
        <span class="rotulo">{{localize (concat "PYRO.Atributos." chave)}}</span>
        <span class="pool numero">{{attr.pool}}</span>
      </button>
      <div class="atributo-base {{#if attr.mostrarDetalhe}}com-detalhe{{/if}}">
        <input class="numero" type="number" name="system.atributos.{{chave}}.valor"
               value="{{attr.valor}}" min="1" />
        {{!-- Em repouso a célula mostra o valor em jogo. O hover troca pela
              conta que chegou nele ("14 +1"), e o clique cai no campo abaixo,
              que edita só a base. Os dois textos não recebem clique: quem
              recebe é sempre o input. --}}
        <span class="atributo-total numero {{attr.classeTotal}}"
              title="{{attr.dicaTotal}}">{{attr.totalTexto}}</span>
        {{#if attr.mostrarDetalhe}}
        <span class="atributo-detalhe numero {{attr.classeTotal}}"
              title="{{attr.dicaTotal}}">{{attr.detalheTexto}}</span>
        {{/if}}
      </div>
    </div>
    {{/each}}
  </div>
</div>
