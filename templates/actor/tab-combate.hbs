<section class="tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">

  <div class="colunas">
    <div class="painel defesas">
      <h3 class="titulo-secao">{{localize "PYRO.Defesas"}}</h3>
      <div class="defesas-colunas">
        {{#each defesaColunas as |col|}}
        <div class="def-col">
          <div class="def categoria">
            <span>{{col.label}}</span>
            <span class="total numero">{{col.total}}</span>
          </div>
          {{#each col.tipos as |t|}}
          <div class="def">
            <span>{{t.label}}</span>
            <span class="total numero">{{t.total}}</span>
          </div>
          {{/each}}
        </div>
        {{/each}}
      </div>

      {{!-- Só o que está em curso: uma lista com todas as condições possíveis
            faria o jogador procurar o que ele de fato tem. --}}
      {{#if efeitosSofridos.linhas.length}}
      <div class="efeitos-sofridos">
        <h3 class="titulo-secao">{{localize "PYRO.Efeitos.Sofrendo"}}</h3>
        {{#each efeitosSofridos.linhas as |e|}}
        <p class="efeito-sofrido efeito-{{e.chave}}">
          <span class="efeito-texto">{{e.titulo}}</span>
          {{#if e.prazo}}<span class="efeito-prazo">{{e.prazo}}</span>{{/if}}
        </p>
        {{/each}}
        {{#if efeitosSofridos.notaMental}}
        <p class="pyro-nota">{{localize "PYRO.Efeitos.MentalSemRegra"}}</p>
        {{/if}}
      </div>
      {{/if}}
    </div>

    <div class="painel lateral">
      <h3 class="titulo-secao">{{localize "PYRO.Combate"}}</h3>
      <p class="stat-inline"><i class="fa-solid fa-person-running"></i>
        {{localize "PYRO.Velocidade"}} <span class="valor numero">{{system.velocidade}}m</span></p>
      {{!-- Voo e natação só aparecem em quem os tem: numa ficha comum os dois
            seriam duas linhas de zero. --}}
      {{#if system.deslocamentoAereo}}
      <p class="stat-inline {{#if system.vooBloqueado}}perigo{{/if}}"
         title="{{localize 'PYRO.DeslocamentoAereoDica'}}">
        <i class="fa-solid fa-feather"></i>
        {{localize "PYRO.DeslocamentoAereo"}}
        <span class="valor numero">{{system.deslocamentoAereo}}m</span>
        {{#if system.vooBloqueado}}<i class="fa-solid fa-ban"></i>{{/if}}</p>
      {{/if}}
      {{#if system.deslocamentoNatacao}}
      <p class="stat-inline"><i class="fa-solid fa-person-swimming"></i>
        {{localize "PYRO.DeslocamentoNatacao"}}
        <span class="valor numero">{{system.deslocamentoNatacao}}m</span></p>
      {{/if}}
      <div class="botoes-reacao">
        <button type="button" data-action="rolarEsquiva"
                title="{{localize 'PYRO.EsquivaTooltip'}}">{{localize "PYRO.Esquivar"}} ({{system.esquiva}})</button>
        <button type="button" data-action="rolarBloqueio"
                title="{{localize 'PYRO.BloqueioTooltip'}}">{{localize "PYRO.Bloquear"}} ({{system.bloqueio}})</button>
        <button type="button" data-action="tomarAr"
                title="{{localize 'PYRO.TomarArTooltip'}}">{{localize "PYRO.TomarAr"}}</button>
        <button type="button" data-action="abrirGuiaAcoes"
                title="{{localize 'PYRO.GuiaAcoes.Tooltip'}}">
          <i class="fa-solid fa-list"></i> {{localize "PYRO.GuiaAcoes.Abrir"}}
        </button>
      </div>

      {{!-- Benefício e Inspiração Divina são escolhidos no diálogo do teste, e
            a Sorte no card da rolagem: o único uso que mora na ficha é
            agarrar-se à vida a 0 PV. Fora dessa hora o bloco inteiro sai, em
            vez de ficar ocupando espaço para dizer que não há o que clicar. --}}
      {{#if podeVontadeDeViver}}
      <h3 class="titulo-secao">{{localize "PYRO.Vontade.Nome"}}</h3>
      <div class="botoes-reacao vontade">
        <button type="button" data-action="vontadeDeViver"
                title="{{localize 'PYRO.Vontade.ViverDica'}}">
          <i class="fa-solid fa-heart-pulse"></i>
          {{localize "PYRO.Vontade.Viver"}} ({{custoVontadeDeViver}})
        </button>
      </div>
      {{/if}}

      <h3 class="titulo-secao">{{localize "PYRO.Exaustao.Nome"}}</h3>
      <div class="botoes-reacao exaustao" title="{{localize 'PYRO.Exaustao.Dica'}}">
        <button type="button" data-action="ajustarExaustao" data-delta="-1"
                title="{{localize 'PYRO.Exaustao.Menos'}}" {{#unless exaustao}}disabled{{/unless}}>
          <i class="fa-solid fa-minus"></i></button>
        <span class="exaustao-nivel numero {{#if exaustao}}com-exaustao{{/if}}">{{exaustao}}</span>
        <button type="button" data-action="ajustarExaustao" data-delta="1"
                title="{{localize 'PYRO.Exaustao.Mais'}}"><i class="fa-solid fa-plus"></i></button>
      </div>
    </div>
  </div>

  {{!-- Postura ativa (SRD Técnicas): entrar ou trocar custa 1 ação, e só uma
        vale por vez, então a escolha é uma barra e não uma lista de marcas. --}}
  {{#if posturas.length}}
  <div class="painel posturas">
    <h3 class="titulo-secao">{{localize "PYRO.Postura.Nome"}}</h3>
    <div class="barra-posturas">
      {{#each posturas as |p|}}
      <button type="button" class="postura {{#if p.ativa}}ativa{{/if}}"
              data-action="alternarPostura" data-item-id="{{p.id}}"
              title="{{localize (pyroSe p.ativa 'PYRO.Postura.Sair' 'PYRO.Postura.Entrar')}}">
        <img src="{{p.img}}" alt="" />
        <span>{{p.nome}}</span>
      </button>
      {{/each}}
    </div>
    <p class="pyro-nota">{{localize "PYRO.Postura.Custo"}}</p>
  </div>
  {{/if}}

  {{> "pyro.secao" secao=secoes.favoritos}}

  {{#if system.temTecnicas}}
  {{> "pyro.secao" secao=secoes.tecnicas}}
  {{/if}}
</section>
