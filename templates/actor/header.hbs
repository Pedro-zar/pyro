<header class="ficha-topo">
  <img class="retrato" src="{{actor.img}}" data-edit="img" data-action="editImage"
       alt="{{actor.name}}" title="{{localize 'PYRO.TrocarRetrato'}}" />

  <div class="topo-corpo">
    <div class="topo-identidade">
      <input class="nome display" type="text" name="name" value="{{actor.name}}"
             placeholder="{{localize 'PYRO.Nome'}}" />

      <div class="topo-acoes">
        {{!--
          Selos clicáveis: o escolhido tinge a ficha inteira. No selo do mago
          já ativo, um segundo clique abre uma amostra por elemento de
          afinidade, para escolher a cor exata.
        --}}
        {{#if selosPoder.length}}
        <div class="poderes-selos">
          {{#each selosPoder as |selo|}}
          {{#if @root.podeTrocarTema}}
          <button type="button" class="selo-poder selo-{{selo.chave}}{{#if selo.ativo}} ativo{{/if}}"
                  style="--cor-selo: {{selo.cor}}" title="{{selo.dica}}"
                  data-action="escolherVocacao" data-vocacao="{{selo.chave}}"></button>
          {{else}}
          <span class="selo-poder selo-{{selo.chave}}{{#if selo.ativo}} ativo{{/if}}"
                style="--cor-selo: {{selo.cor}}" title="{{selo.label}}"></span>
          {{/if}}
          {{/each}}

          {{#if coresElemento.length}}
          <div class="cores-vocacao" hidden>
            {{#each coresElemento as |c|}}
            <button type="button" class="cor-elemento{{#if c.ativo}} ativo{{/if}}"
                    style="--cor-el: var(--pyro-el-{{c.chave}})" title="{{c.dica}}"
                    data-action="escolherCorElemento" data-elemento="{{c.chave}}"></button>
            {{/each}}
          </div>
          {{/if}}
        </div>
        {{/if}}
        <div class="selo-det" title="{{localize 'PYRO.DetTooltip'}}">
          <span class="selo-rotulo">{{localize "PYRO.DET"}}</span>
          {{!-- A DET só desce a 0 com a regra do prólogo ligada no mundo. --}}
          <input class="numero" type="number" name="system.det" value="{{system.det}}" min="{{detMin}}" />
        </div>

        <button type="button" class="botao-menu" data-action="abrirRecuperacao"
                title="{{localize 'PYRO.Recuperar.Titulo'}}">
          <i class="fa-solid fa-hourglass-half"></i>
        </button>
      </div>
    </div>

    <p class="topo-subtitulo">
      {{#each identidade as |parte|}}
      <span class="{{parte.classe}}"{{#if parte.cor}} style="color: var(--pyro-el-{{parte.cor}})"{{/if}}>{{parte.texto}}</span>
      {{/each}}
      {{#if podeEditarTamanho}}
      <select class="mini-select" name="system.tamanho">
        {{selectOptions tamanhoOpts selected=system.tamanho localize=true}}
      </select>
      {{/if}}
    </p>

    <div class="recursos" style="--rec-cols: {{recursosCols}};">
      {{#each recursosVisiveis as |rec|}}
      <div class="recurso" style="--cor: var(--pyro-{{rec.chave}}, var(--pyro-recurso-custom))">
        <div class="recurso-topo">
          <span class="rotulo">{{rec.label}}</span>
          {{#if rec.nota}}<span class="recurso-nota">{{rec.nota}}</span>{{/if}}
        </div>
        <div class="barra" role="img" aria-label="{{rec.label}} {{rec.value}}/{{rec.max}}">
          <div class="barra-preenchida" style="width: {{rec.pct}}%"></div>
          <div class="barra-texto numero">
            <input type="number" name="system.recursos.{{rec.chave}}.value" value="{{rec.value}}" />
            <span class="barra-max">/ {{rec.max}}</span>
          </div>
        </div>
      </div>
      {{/each}}
    </div>

    {{#if alertas.length}}
    <div class="alertas">
      {{#each alertas as |a|}}
      <span class="alerta {{a.tom}}"><i class="fa-solid {{a.icone}}"></i> {{a.texto}}</span>
      {{/each}}
    </div>
    {{/if}}
  </div>
</header>
