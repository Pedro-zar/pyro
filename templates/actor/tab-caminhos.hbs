<section class="tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">
  <div class="lista-itens">
    <header class="lista-cabecalho">
      <h3>{{localize "TYPES.Item.caminho"}}</h3>
      <button type="button" class="icone" data-action="criarItem" data-type="caminho"
              title="{{localize 'PYRO.Criar'}}"><i class="fa-solid fa-plus"></i></button>
    </header>
    <ol>
      {{#each caminhos as |item|}}
      {{> "systems/pyro/templates/actor/partials/item-linha.hbs" linha=item}}
      {{/each}}
    </ol>
  </div>
  <p class="pyro-nota">{{localize "PYRO.CaminhosNota"}}</p>
</section>
