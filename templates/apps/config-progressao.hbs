<div class="config-corpo">
  <section>
    <header class="lista-cabecalho">
      <h3>{{localize "PYRO.Progressao.Regras"}}</h3>
      <button type="button" class="icone" data-action="adicionarRegra"
              title="{{localize 'PYRO.Criar'}}"><i class="fa-solid fa-plus"></i></button>
    </header>
    <p class="pyro-nota">{{localize "PYRO.Progressao.RegrasDica"}}</p>
    <p class="pyro-nota">{{localize "PYRO.Progressao.CurvaPadrao"}} <code>{{exemploPadrao}}</code></p>

    {{#if regras.length}}
    <div class="config-cab progressoes">
      <span>{{localize "PYRO.Progressao.Rotulo"}}</span>
      <span>{{localize "PYRO.Progressao.Nomes"}}</span>
      <span>{{localize "PYRO.Progressao.Passo"}}</span>
      <span>{{localize "PYRO.Progressao.Multiplicador"}}</span>
      <span></span>
    </div>
    {{#each regras as |r|}}
    <div class="config-linha progressoes">
      <input type="text" name="regra.{{r.chave}}.label" value="{{r.label}}" />
      <input type="text" name="regra.{{r.chave}}.nomes" value="{{r.nomes}}"
             placeholder="{{localize 'PYRO.Progressao.NomesPlaceholder'}}" />
      <input type="number" name="regra.{{r.chave}}.passo" value="{{r.passo}}" min="1" step="1" />
      <input type="number" step="any" name="regra.{{r.chave}}.multiplicador"
             value="{{r.multiplicador}}" min="0" />
      <button type="button" class="icone perigo" data-action="removerRegra" data-chave="{{r.chave}}"
              title="{{localize 'PYRO.Excluir'}}"><i class="fa-solid fa-xmark"></i></button>
    </div>
    {{!-- Prévia dos seis primeiros custos: o efeito da regra sem abrir ficha.
          Só atualiza ao salvar ou ao mexer na lista, que é quando a janela
          se re-renderiza. --}}
    <p class="progressao-exemplo"><span class="rotulo">{{localize "PYRO.Progressao.Exemplo"}}</span>
      <code>{{r.exemplo}}</code></p>
    {{/each}}
    {{else}}
    <p class="secao-vazia">{{localize "PYRO.Progressao.Vazio"}}</p>
    {{/if}}
  </section>

  <footer class="config-rodape">
    <button type="submit" class="destaque">
      <i class="fa-solid fa-floppy-disk"></i> {{localize "PYRO.Config.Salvar"}}
    </button>
  </footer>
</div>
