<div class="construtor-corpo">
  {{!--
    Os valores vêm do estado da janela, e não de um padrão fixo: a janela se
    re-renderiza a cada linha nova ou troca de categoria, e o que já foi
    digitado tem que sobreviver a isso.
  --}}
  <div class="linha-campos">
    <label class="campo cresce"><span>{{localize "PYRO.Efeitos.NomeEfeito"}}</span>
      <input type="text" name="nome" value="{{nome}}" /></label>
    <label class="campo"><span>{{localize "PYRO.Efeitos.Duracao"}}</span>
      <input type="text" name="prazo" value="{{prazo}}" /></label>
    <label class="campo"><span>{{localize "PYRO.Efeitos.Unidade"}}</span>
      <select name="unidade">{{selectOptions unidades selected=unidade}}</select></label>
  </div>
  <p class="pyro-nota">{{localize "PYRO.Efeitos.DuracaoDica"}}</p>

  {{#if podeSerDeUso}}
  <div class="campos-check">
    <label class="check-linha"><input type="checkbox" name="deUso" {{checked deUso}} />
      <span>{{localize "PYRO.Efeitos.DeUso"}}</span></label>
    {{!-- Só na transformação: o efeito espera a forma acabar em vez de valer
          enquanto ela dura. --}}
    {{#if podeSerAoAcabar}}
    <label class="check-linha"><input type="checkbox" name="aoAcabar" {{checked aoAcabar}} />
      <span>{{localize "PYRO.Efeitos.AoAcabar"}}</span></label>
    {{/if}}
  </div>
  {{pyroDica "PYRO.Efeitos.DeUsoDica"}}
  {{/if}}

  <div class="mudancas">
    <div class="lista-cabecalho">
      <h3>{{localize "PYRO.Efeitos.OQueMuda"}}</h3>
      <button type="button" class="icone" data-action="adicionarMudanca"
              title="{{localize 'PYRO.Criar'}}"><i class="fa-solid fa-plus"></i></button>
    </div>
    <div class="mudanca-cab">
      <span>{{localize "PYRO.Efeitos.Categoria"}}</span>
      <span>{{localize "PYRO.Efeitos.AlvoLabel"}}</span>
      <span>{{localize "PYRO.Efeitos.ModoLabel"}}</span>
      <span>{{localize "PYRO.Efeitos.Valor"}}</span>
      <span></span>
    </div>
    {{#each mudancas as |m|}}
    <div class="mudanca-linha" data-index="{{m.index}}">
      <select name="mudanca.{{m.index}}.categoria" data-campo="categoria">
        {{selectOptions @root.categorias selected=m.categoria localize=true}}
      </select>
      <select name="mudanca.{{m.index}}.alvo">
        {{selectOptions m.alvos selected=m.alvo localize=true}}
      </select>
      {{#if m.ehExausto}}
      {{!-- Exaustão é a única condição com número: quantos níveis. --}}
      <span class="pyro-nota">{{localize "PYRO.Efeitos.ExaustoModo"}}</span>
      <input type="number" name="mudanca.{{m.index}}.valor" value="{{m.valor}}" min="1" step="1" />
      {{else if m.ehCondicao}}
      <span class="pyro-nota">{{localize "PYRO.Efeitos.CondicaoDica"}}</span>
      <span></span>
      {{else if m.ehDano}}
      {{!-- Dano é rolagem, não alteração de campo: sem modo, e o valor é uma
            fórmula. O "alvo" da linha já é o tipo do dano. --}}
      <span class="pyro-nota">{{localize "PYRO.Efeitos.DanoModo"}}</span>
      <input type="text" name="mudanca.{{m.index}}.valor" value="{{m.valor}}" placeholder="2d6+2" />
      {{else if m.ehMultDano}}
      {{!-- Multiplica o total rolado, não os dados; abaixo de 1 reduz. --}}
      <span class="pyro-nota">{{localize "PYRO.Efeitos.MultDanoModo"}}</span>
      <input type="text" name="mudanca.{{m.index}}.valor" value="{{m.valor}}" placeholder="1 + 0.25 * @nvl" />
      {{else if m.ehCusto}}
      {{!-- Somar é um número com sinal (-2 barateia, +1 encarece);
            multiplicar é um fator (0,5 corta pela metade, 2 dobra). --}}
      <select name="mudanca.{{m.index}}.modo" data-campo="modo">
        {{selectOptions @root.modosDeCusto selected=m.modo localize=true}}
      </select>
      <input type="text" name="mudanca.{{m.index}}.valor" value="{{m.valor}}"
             placeholder="{{pyroSe m.ehCustoMult '0.5' '-2'}}"
             title="{{localize (pyroSe m.ehCustoMult 'PYRO.Efeitos.CustoMultDica' 'PYRO.Efeitos.CustoSomaDica')}}" />
      {{else}}
      <select name="mudanca.{{m.index}}.modo">
        {{selectOptions @root.modos selected=m.modo localize=true}}
      </select>
      <input type="text" name="mudanca.{{m.index}}.valor" value="{{m.valor}}" placeholder="2" />
      {{/if}}
      <button type="button" class="icone perigo" data-action="removerMudanca" data-index="{{m.index}}"
              title="{{localize 'PYRO.Excluir'}}"><i class="fa-solid fa-xmark"></i></button>
    </div>
    {{/each}}
  </div>

  {{!--
    Restrição por item: com algum item marcado, o efeito sai da conta geral da
    ficha e passa a valer só na rolagem daqueles itens. É como "Maestria com
    Katana" soma dano na katana sem somar no arco.
  --}}
  {{#if itensAlvo.length}}
  <div class="restricao-efeito">
    <span class="rotulo">{{localize "PYRO.Efeitos.ApenasEm"}}</span>
    <div class="alvos-lista">
      {{#each itensAlvo as |grupo|}}
      <div class="alvo-grupo">
        {{!-- Marcar o tipo prende o efeito ao grupo inteiro, inclusive nos
              itens criados depois. Os itens abaixo ficam apagados porque
              deixam de fazer diferença. --}}
        <label class="check-linha alvo-tipo">
          <input type="checkbox" name="alvoTipo.{{grupo.tipo}}" {{checked grupo.todos}} />
          <span>{{grupo.label}}</span>
          <span class="rotulo">{{localize "PYRO.Efeitos.TodosDoTipo"}}</span>
        </label>
        <div class="alvo-itens">
          {{#each grupo.itens as |i|}}
          <label class="check-linha">
            <input type="checkbox" name="alvoItem.{{i.id}}" {{checked i.marcado}} />
            <span>{{i.nome}}</span>
          </label>
          {{/each}}
        </div>
      </div>
      {{/each}}
    </div>
    <p class="pyro-nota">{{localize "PYRO.Efeitos.ApenasEmDica"}}</p>
  </div>
  {{/if}}

  {{#if variaveis.length}}
  <div class="variaveis-efeito">
    <span class="rotulo">{{localize "PYRO.Efeitos.Variaveis"}}</span>
    <div class="variaveis-lista">
      {{#each variaveis as |v|}}
      <button type="button" class="ficha-variavel" data-action="inserirVariavel" data-variavel="{{v}}"
              title="{{localize 'PYRO.Efeitos.InserirVariavel'}}">@{{v}}</button>
      {{/each}}
    </div>
    <p class="pyro-nota">{{localize "PYRO.Efeitos.VariaveisDica"}}</p>
  </div>
  {{/if}}

  <p class="pyro-nota">{{localize "PYRO.Efeitos.ValorDica"}}</p>
  <p class="pyro-nota">{{localize "PYRO.Efeitos.TamanhoDica"}}</p>

  <footer class="construtor-rodape">
    {{!-- Ajustes feitos na ficha completa que esta tela não desenha: ficam
          guardados e voltam intactos no salvar. --}}
    {{#if notaAvancadas}}
    <p class="pyro-nota">{{notaAvancadas}}</p>
    {{/if}}
    <button type="button" data-action="avancado">
      <i class="fa-solid fa-sliders"></i>
      {{localize (pyroSe editando "PYRO.Efeitos.SalvarAvancado" "PYRO.Efeitos.Avancado")}}
    </button>
    <button type="submit" class="destaque">
      <i class="fa-solid fa-check"></i>
      {{localize (pyroSe editando "PYRO.Efeitos.SalvarEfeito" "PYRO.Efeitos.CriarEfeito")}}
    </button>
  </footer>
</div>
