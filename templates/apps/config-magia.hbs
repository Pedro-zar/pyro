<div class="config-corpo">
  <section>
    <header class="lista-cabecalho">
      <h3>{{localize "PYRO.Config.Elementos"}}</h3>
      <button type="button" class="icone" data-action="adicionarElemento"
              title="{{localize 'PYRO.Criar'}}"><i class="fa-solid fa-plus"></i></button>
    </header>
    <p class="pyro-nota">{{localize "PYRO.Config.ElementosDica"}}</p>
    {{#each elementos as |e|}}
    <div class="config-elemento">
      <div class="config-el-cab">
        <code>{{e.chave}}</code>
        <input type="text" name="elemento.{{e.chave}}.label" value="{{e.label}}" />
        <button type="button" class="icone perigo" data-action="removerElemento" data-chave="{{e.chave}}"
                title="{{localize 'PYRO.Excluir'}}"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="config-el-campos">
        <label><span>{{localize "PYRO.Config.Grupo"}}</span>
          <input type="text" name="elemento.{{e.chave}}.grupo" value="{{e.grupo}}" /></label>
        <label><span>{{localize "PYRO.Item.TipoDano"}}</span>
          <select name="elemento.{{e.chave}}.tipoDano">{{selectOptions @root.tiposDano selected=e.tipoDano}}</select></label>
        <label><span>{{localize "PYRO.Item.Base"}}</span>
          <input type="number" step="any" name="elemento.{{e.chave}}.base" value="{{e.base}}" /></label>
        <label><span>{{localize "PYRO.Item.PorIntencao"}}</span>
          <input type="number" step="any" name="elemento.{{e.chave}}.porIntencao" value="{{e.porIntencao}}" /></label>
        <label><span>{{localize "PYRO.Item.Faces"}}</span>
          <input type="number" name="elemento.{{e.chave}}.faces" value="{{e.faces}}" min="0" /></label>
      </div>
      <textarea name="elemento.{{e.chave}}.efeito" rows="2"
                placeholder="{{localize 'PYRO.Config.EfeitoTexto'}}">{{e.efeito}}</textarea>
      <div class="campos-check">
        <label class="check-linha"><input type="checkbox" name="elemento.{{e.chave}}.subjulgar" {{checked e.subjulgar}} />
          <span>{{localize "PYRO.Config.Subjulgar"}}</span></label>
      </div>
    </div>
    {{/each}}
  </section>

  <footer class="config-rodape">
    <button type="button" data-action="restaurar">
      <i class="fa-solid fa-rotate-left"></i> {{localize "PYRO.Config.Restaurar"}}
    </button>
    <button type="submit" class="destaque">
      <i class="fa-solid fa-floppy-disk"></i> {{localize "PYRO.Config.Salvar"}}
    </button>
  </footer>
</div>
