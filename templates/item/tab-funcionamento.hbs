<section class="tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">

{{#if isArma}}
  <div class="bloco">
    <h4 class="titulo-secao">{{localize "PYRO.Bloco.Dano"}}
      <button type="button" class="icone" data-action="adicionarDano"
              title="{{localize 'PYRO.Item.AdicionarDano'}}"><i class="fa-solid fa-plus"></i></button>
    </h4>
    {{#each system.danos as |d idx|}}
    <div class="linha-dano">
      <input type="text" name="system.danos.{{idx}}.formula" value="{{d.formula}}" placeholder="2d8 + [DES]" />
      <select name="system.danos.{{idx}}.tipo">{{selectOptions @root.tiposDano selected=d.tipo localize=true}}</select>
      <button type="button" class="icone perigo" data-action="removerDano" data-index="{{idx}}"
              title="{{localize 'PYRO.Excluir'}}"><i class="fa-solid fa-xmark"></i></button>
    </div>
    {{/each}}
    {{!-- O sistema não escala a arma pelo tamanho de quem a usa: o número
          fica aqui para você aplicar na fórmula acima. --}}
    {{#if dadosArmaDica}}
    <p class="pyro-nota">{{dadosArmaDica}}</p>
    {{/if}}
    {{#if mostrarRecursoMental}}
    <label class="campo largo"><span class="rotulo">{{localize "PYRO.Item.RecursoMental"}}</span>
      <select name="system.recursoMental">{{selectOptions recursosMentaisOpts selected=system.recursoMental}}</select></label>
    <p class="pyro-nota">{{localize "PYRO.Item.RecursoMentalDica"}}</p>
    {{/if}}
  </div>

  <div class="bloco">
    <h4 class="titulo-secao">{{localize "PYRO.Bloco.Uso"}}</h4>
    <div class="grade-campos">
      <label class="campo"><span class="rotulo">{{localize "PYRO.Acoes"}}</span>
        <input type="number" name="system.acoes" value="{{system.acoes}}" min="1" /></label>
      <label class="campo"><span class="rotulo">{{localize "PYRO.Item.Maos"}}</span>
        <input type="number" name="system.maos" value="{{system.maos}}" min="1" max="2" /></label>
      {{!-- Tamanho da arma, não de quem empunha. Médio é o padrão e não muda
            nada; os outros ganham o lembrete no bloco de dano. --}}
      <label class="campo largo"><span class="rotulo">{{localize "PYRO.Item.TamanhoArma"}}</span>
        <select name="system.tamanho">{{selectOptions tamanhoOpts selected=system.tamanho localize=true}}</select></label>
      <label class="campo"><span class="rotulo">{{localize "PYRO.Item.AlcanceMenor"}}</span>
        <input type="number" name="system.alcanceMenor" value="{{system.alcanceMenor}}" min="0" /></label>
      <label class="campo"><span class="rotulo">{{localize "PYRO.Item.AlcanceMaximo"}}</span>
        <input type="number" name="system.alcanceMaximo" value="{{system.alcanceMaximo}}" min="0" /></label>
    </div>
  </div>
{{/if}}

{{#if isEquipamento}}
  <div class="bloco">
    <h4 class="titulo-secao">{{localize "PYRO.Bloco.Uso"}}</h4>
    <div class="grade-campos">
      <label class="campo largo"><span class="rotulo">{{localize "PYRO.Item.Categoria"}}</span>
        <select name="system.categoria">{{selectOptions config.categoriasEquipamento selected=system.categoria localize=true}}</select></label>
      <label class="campo largo"><span class="rotulo">{{localize "PYRO.Item.Parte"}}</span>
        <select name="system.parte">{{selectOptions config.partesCorpo selected=system.parte localize=true}}</select></label>
      {{#if ehMochila}}
      <label class="campo"><span class="rotulo">{{localize "PYRO.Item.CargaBonus"}}</span>
        <input type="number" name="system.cargaBonus" value="{{system.cargaBonus}}" min="0" /></label>
      {{/if}}
      {{#if ehArcano}}
      <label class="campo"><span class="rotulo">{{localize "PYRO.Item.ReducaoMana"}}</span>
        <input type="number" name="system.reducaoMana" value="{{system.reducaoMana}}" min="0" /></label>
      {{/if}}
      <label class="campo"><span class="rotulo">{{localize "PYRO.Bloquear"}} +</span>
        <input type="text" name="system.bloqueio" value="{{system.bloqueio}}" placeholder="1d4" /></label>
      <label class="campo"><span class="rotulo">{{localize "PYRO.Esquivar"}} +</span>
        <input type="text" name="system.esquiva" value="{{system.esquiva}}" placeholder="1d12" /></label>
    </div>
    {{#if ehMochila}}<p class="pyro-nota">{{localize "PYRO.Item.CargaBonusDica"}}</p>{{/if}}
    {{#if ehArcano}}<p class="pyro-nota">{{localize "PYRO.Item.ReducaoManaDica"}}</p>{{/if}}
  </div>

  <div class="bloco">
    <h4 class="titulo-secao">{{localize "PYRO.Item.DefesasCategorias"}}</h4>
    <div class="grade-def-equip">
      <label><span class="rotulo">{{localize "PYRO.Dano.fisico"}}</span>
        <input type="number" name="system.defesas.categorias.fisico" value="{{system.defesas.categorias.fisico}}" /></label>
      <label><span class="rotulo">{{localize "PYRO.Dano.energetico"}}</span>
        <input type="number" name="system.defesas.categorias.energetico" value="{{system.defesas.categorias.energetico}}" /></label>
      <label><span class="rotulo">{{localize "PYRO.Dano.mental"}}</span>
        <input type="number" name="system.defesas.categorias.mental" value="{{system.defesas.categorias.mental}}" /></label>
    </div>
  </div>

  <div class="bloco">
    <h4 class="titulo-secao">{{localize "PYRO.Item.DefesasTipos"}}</h4>
    <div class="grade-def-equip">
      {{#each system.defesas.tipos as |val tipo|}}
      <label><span class="rotulo">{{localize (lookup (lookup @root.config.tiposDano tipo) "label")}}</span>
        <input type="number" name="system.defesas.tipos.{{tipo}}" value="{{val}}" /></label>
      {{/each}}
    </div>
  </div>
{{/if}}

{{#if isConsumivel}}
  <div class="bloco">
    <h4 class="titulo-secao">{{localize "PYRO.Bloco.Uso"}}</h4>
    <div class="grade-campos">
      {{#unless system.municao}}
      <label class="campo"><span class="rotulo">{{localize "PYRO.Acoes"}}</span>
        <input type="number" name="system.acoes" value="{{system.acoes}}" min="0" /></label>
      {{/unless}}
      <label class="campo largo">
        <span class="rotulo">{{#if system.municao}}{{localize "PYRO.Item.Dano"}}{{else}}{{localize "PYRO.Item.Formula"}}{{/if}}</span>
        <input type="text" name="system.formula" value="{{system.formula}}" placeholder="2d8" /></label>
      {{#if system.municao}}
      <label class="campo largo"><span class="rotulo">{{localize "PYRO.Item.TipoDano"}}</span>
        <select name="system.tipoDano">{{selectOptions tiposDano selected=system.tipoDano localize=true}}</select></label>
      <label class="campo largo"><span class="rotulo">{{localize "PYRO.Item.Parte"}}</span>
        <select name="system.parte">{{selectOptions parteMunicaoOpts selected=system.parte localize=true}}</select></label>
      {{/if}}
    </div>
  </div>
{{/if}}

{{#if isHabilidade}}
  <div class="bloco">
    <h4 class="titulo-secao">{{localize "PYRO.Bloco.Identificacao"}}</h4>
    <div class="grade-campos">
      {{#if caminhoOpts}}
      <label class="campo largo"><span class="rotulo">{{localize "TYPES.Item.caminho"}}</span>
        <select name="system.caminho">{{selectOptions caminhoOpts selected=system.caminho}}</select></label>
      {{else}}
      <label class="campo largo"><span class="rotulo">{{localize "TYPES.Item.caminho"}}</span>
        <input type="text" name="system.caminho" value="{{system.caminho}}" /></label>
      {{/if}}
      <label class="campo largo" title="{{#if system.ehPostura}}{{localize 'PYRO.Postura.Dica'}}{{/if}}">
        <span class="rotulo">{{localize "PYRO.Item.Categoria"}}</span>
        <select name="system.categoria">{{selectOptions config.categoriasHabilidade selected=system.categoria localize=true}}</select></label>
      {{#if system.ehPostura}}<p class="pyro-nota">{{localize "PYRO.Postura.Dica"}}</p>{{/if}}
      <label class="campo largo"><span class="rotulo">{{localize "PYRO.Item.Tier"}}</span>
        <select name="system.tier">{{selectOptions tierOpts selected=system.tier}}</select></label>
      <div class="campo"><span class="rotulo">{{localize "PYRO.Item.CustoXp"}}</span>
        <span class="valor-texto numero">{{#if system.ehBase}}{{localize "PYRO.Item.BaseTag"}}{{else}}{{system.custoXp}}{{/if}}</span></div>
    </div>
  </div>

  {{!-- Nível (SRD §3): o SRD ainda não fechou como ele sobe, então é editado
        à mão; a escala diz o que muda a cada nível. --}}
  <div class="bloco">
    <h4 class="titulo-secao">{{localize "PYRO.Uso.Bloco"}}</h4>
    <div class="grade-campos">
      <label class="campo"><span class="rotulo">{{localize "PYRO.Uso.Nivel"}}</span>
        <input type="number" name="system.nivel" value="{{system.nivel}}" min="1" /></label>
      <label class="campo"><span class="rotulo">{{localize "PYRO.Uso.NivelMax"}}</span>
        <input type="number" name="system.nivelMax" value="{{system.nivelMax}}" min="1" /></label>
      <label class="campo cresce"><span class="rotulo">{{localize "PYRO.Item.EscalaPorNivel"}}</span>
        <input type="text" name="system.escalaPorNivel" value="{{system.escalaPorNivel}}"
               placeholder="{{localize 'PYRO.Item.EscalaPorNivelPlaceholder'}}" /></label>
    </div>
    <p class="pyro-nota">{{localize "PYRO.Item.NivelHabilidadeDica"}}</p>
  </div>

  {{#if temCustos}}
  <div class="bloco">
    <h4 class="titulo-secao">{{localize "PYRO.Bloco.Custos"}}</h4>
    <div class="grade-campos">
      <label class="campo largo"><span class="rotulo">{{localize "PYRO.Item.TipoCusto"}}</span>
        <select name="system.tipoCusto">{{selectOptions tipoCustoOpts selected=system.tipoCusto localize=true}}</select></label>
      <label class="campo"><span class="rotulo">{{localize "PYRO.Item.Quantas"}}</span>
        <input type="number" name="system.custoAcoes" value="{{system.custoAcoes}}" min="0" /></label>
      <label class="campo"><span class="rotulo">{{localize "PYRO.Recursos.estamina"}}</span>
        <input type="number" name="system.custoEstamina" value="{{system.custoEstamina}}" min="0" /></label>
      <label class="campo"><span class="rotulo">{{localize "PYRO.Recursos.mana"}}</span>
        <input type="number" name="system.custoMana" value="{{system.custoMana}}" min="0" /></label>
      <label class="campo"><span class="rotulo">{{localize "PYRO.Recursos.energia"}}</span>
        <input type="number" name="system.custoEnergia" value="{{system.custoEnergia}}" min="0" /></label>
    </div>
  </div>
  {{/if}}

  <div class="bloco">
    <h4 class="titulo-secao">{{localize "PYRO.Bloco.Rolagem"}}</h4>
    <label class="campo cresce"><span class="rotulo">{{localize "PYRO.Item.Formula"}}</span>
      <input type="text" name="system.formula" value="{{system.formula}}" placeholder="4d6 + [FOR]" /></label>
  </div>
{{/if}}

{{#if isTecnica}}
  <div class="bloco">
    <h4 class="titulo-secao">{{localize "PYRO.Bloco.Identificacao"}}</h4>
    <div class="grade-campos">
      <label class="campo largo"><span class="rotulo">{{localize "PYRO.Tecnica.AcaoBase"}}</span>
        <select name="system.acaoBase">{{selectOptions acoesBaseOpts selected=system.acaoBase localize=true}}</select></label>
      <label class="campo largo"><span class="rotulo">{{localize "PYRO.Item.Tier"}}</span>
        <select name="system.tier">{{selectOptions tierOpts selected=system.tier}}</select></label>
      <label class="campo" title="{{localize 'PYRO.Tecnica.AcoesDica'}}">
        <span class="rotulo">{{localize "PYRO.Acoes"}}</span>
        <input type="number" name="system.acoes" value="{{system.acoes}}" min="1" /></label>
      <div class="campo"><span class="rotulo">{{localize "PYRO.Tecnica.AcoesDaBase"}}</span>
        <span class="valor-texto numero">{{acoesDaBase}}</span></div>
    </div>
  </div>

  {{!-- A condição imposta ao ataque, e o filtro que separa as armas da ficha
        sozinho: quem escolhe "armas pesadas" não marca arma por arma. --}}
  <div class="bloco">
    <h4 class="titulo-secao">{{localize "PYRO.Tecnica.Especificidade"}}</h4>
    <div class="grade-campos">
      <label class="campo largo"><span class="rotulo">{{localize "PYRO.Tecnica.Condicao"}}</span>
        <select name="system.especificidade">{{selectOptions especificidadeOpts selected=system.especificidade}}</select></label>
      {{#if filtroOpts}}
      <label class="campo largo"><span class="rotulo">{{localize "PYRO.Tecnica.ValePara"}}</span>
        <select name="system.filtro">{{selectOptions filtroOpts selected=system.filtro}}</select></label>
      {{/if}}
      {{#if ataquesOpts}}
      <label class="campo largo"><span class="rotulo">{{localize "PYRO.Tecnica.AtaqueEspecifico"}}</span>
        <select name="system.ataque.id">{{selectOptions ataquesOpts selected=system.ataque.id}}</select></label>
      {{/if}}
    </div>
    <p class="pyro-nota">{{localize "PYRO.Tecnica.EspecificidadeDica"}}</p>
  </div>

  <div class="bloco">
    <header class="lista-cabecalho">
      <h4 class="titulo-secao">{{localize "PYRO.Tecnica.Tracos"}}</h4>
      <span class="pyro-pontos {{#if pontosExcedidos}}perigo{{/if}}{{#if pontosSobrando}} alerta{{/if}}">
        {{pontos.gastos}} / {{pontos.disponiveis}} {{localize "PYRO.Tecnica.Pontos"}}
      </span>
      {{#if podeAdicionarTraco}}
      <button type="button" class="icone" data-action="adicionarTraco"
              title="{{localize 'PYRO.Criar'}}"><i class="fa-solid fa-plus"></i></button>
      {{/if}}
    </header>

    {{#if tracosDaTecnica.length}}
    <div class="config-cab tracos-item">
      <span>{{localize "PYRO.Tecnica.Traco1"}}</span>
      <span>{{localize "PYRO.Tecnica.Grau"}}</span>
      <span>{{localize "PYRO.Tecnica.CustoPontos"}}</span>
      <span>{{localize "PYRO.Tecnica.NoGrau"}}</span>
      <span></span>
    </div>
    {{#each tracosDaTecnica as |t|}}
    <div class="config-linha tracos-item">
      <select name="system.tracos.{{t.indice}}.chave">{{selectOptions t.opcoes selected=t.chave}}</select>
      <input type="number" name="system.tracos.{{t.indice}}.grau" value="{{t.grau}}" min="1" />
      <span class="valor-texto numero">{{t.custo}}</span>
      <span class="valor-texto">{{t.efeito}}</span>
      <button type="button" class="icone perigo" data-action="removerTraco" data-index="{{t.indice}}"
              title="{{localize 'PYRO.Excluir'}}"><i class="fa-solid fa-xmark"></i></button>
    </div>
    {{/each}}
    {{else}}
    <p class="secao-vazia">{{localize "PYRO.Tecnica.SemTracos"}}</p>
    {{/if}}

    {{#if pontosExcedidos}}
    <p class="pyro-aviso"><i class="fa-solid fa-triangle-exclamation"></i>
      {{localize "PYRO.Tecnica.PontosExcedidos"}}</p>
    {{/if}}
  </div>

  <div class="bloco">
    <h4 class="titulo-secao">{{localize "PYRO.Tecnica.PontosFracos"}}</h4>
    <p class="pyro-nota">{{localize "PYRO.Tecnica.OnusDica"}}</p>
    <div class="campos-check">
      {{#each onusOpts as |o|}}
      <label class="check-linha"><input type="checkbox" name="system.onus.{{o.chave}}" {{checked o.marcado}} />
        <span>{{o.label}}</span></label>
      {{/each}}
    </div>
  </div>

  {{!-- Uma variação por postura conhecida (SRD Técnicas): a técnica muda de
        forma conforme a guarda em que é executada. --}}
  {{#if variacoesPostura.length}}
  <div class="bloco">
    <h4 class="titulo-secao">{{localize "PYRO.Tecnica.Variacoes"}}</h4>
    <div class="grade-campos">
      {{#each variacoesPostura as |v|}}
      <label class="campo cresce"><span class="rotulo">{{v.nome}}</span>
        <input type="text" name="system.variacoes.{{v.id}}" value="{{v.texto}}"
               placeholder="{{localize 'PYRO.Tecnica.VariacaoPlaceholder'}}" /></label>
      {{/each}}
    </div>
  </div>
  {{/if}}

  {{> "pyro.progresso"}}
{{/if}}

{{#if isPericia}}
  <div class="bloco">
    <h4 class="titulo-secao">{{localize "PYRO.Pericia.Atributos"}}</h4>
    <p class="pyro-nota">{{localize "PYRO.Pericia.AtributosDica"}}</p>
    <div class="campos-check">
      {{#each atributosPericia as |a|}}
      <label class="check-linha"><input type="checkbox" name="system.atributos.{{a.chave}}" {{checked a.marcado}} />
        <span>{{a.label}}</span></label>
      {{/each}}
    </div>
  </div>
  {{> "pyro.progresso"}}
  <div class="bloco">
    <h4 class="titulo-secao">{{localize "PYRO.Bloco.Regras"}}</h4>
    <div class="campos-check">
      <label class="check-linha" title="{{localize 'PYRO.Pericia.FerramentasDica'}}">
        <input type="checkbox" name="system.exigeFerramentas" {{checked system.exigeFerramentas}} />
        <span>{{localize "PYRO.Pericia.ExigeFerramentas"}}</span></label>
      <label class="check-linha" title="{{localize 'PYRO.Pericia.SoSucessoDica'}}">
        <input type="checkbox" name="system.contaSoSucesso" {{checked system.contaSoSucesso}} />
        <span>{{localize "PYRO.Pericia.ContaSoSucesso"}}</span></label>
    </div>
  </div>
{{/if}}

{{#if isFeitico}}
  <div class="bloco">
    <h4 class="titulo-secao">{{localize "PYRO.Bloco.Uso"}}</h4>
    <div class="grade-campos">
      <label class="campo"><span class="rotulo">{{localize "PYRO.Acoes"}}</span>
        <input type="number" name="system.custoAcoes" value="{{system.custoAcoes}}" min="0" /></label>
      <label class="campo largo"><span class="rotulo">{{localize "PYRO.Item.Formula"}}</span>
        <input type="text" name="system.formula" value="{{system.formula}}" placeholder="3d6" /></label>
    </div>
  </div>
{{/if}}

{{#if isRuna}}
  <div class="bloco">
    <h4 class="titulo-secao">{{localize "PYRO.Bloco.Identificacao"}}</h4>
    <div class="grade-campos">
      <label class="campo largo"><span class="rotulo">{{localize "PYRO.Item.TipoRuna"}}</span>
        <select name="system.tipoRuna">{{selectOptions config.tiposRuna selected=system.tipoRuna localize=true}}</select></label>
      {{#if ehElemento}}
      <label class="campo largo"><span class="rotulo">{{localize "PYRO.Item.Subtipo"}}</span>
        <select name="system.subtipo">{{selectOptions subtipos selected=system.subtipo localize=true}}</select></label>
      {{/if}}
      <label class="campo largo"><span class="rotulo">{{localize rotuloPalavra}}</span>
        <input type="text" name="system.palavra" value="{{system.palavra}}"
               placeholder="{{localize 'PYRO.Item.PalavraPlaceholder'}}" /></label>
      <label class="campo largo"><span class="rotulo">{{localize "PYRO.Item.Lingua"}}</span>
        <select name="system.lingua">{{selectOptions linguaOpts selected=system.lingua localize=true}}</select></label>
      {{!-- Mãos é coisa de gesto; o tipo de dano aparece para qualquer runa
            que role dados, inclusive um gesto com escalonamento próprio. --}}
      {{#unless ehElemento}}
      <label class="campo"><span class="rotulo">{{localize "PYRO.Item.Maos"}}</span>
        <input type="number" name="system.maos" value="{{system.maos}}" min="0" /></label>
      {{/unless}}
      {{#if mostrarTipoDano}}
      <label class="campo largo"><span class="rotulo">{{localize "PYRO.Item.TipoDano"}}</span>
        <select name="system.tipoDano">{{selectOptions tipoDanoOpts selected=tipoDanoSelecionado}}</select></label>
      {{/if}}
    </div>
    {{#if mostrarSubjulgar}}
    <div class="campos-check">
      <label class="check-linha"><input type="checkbox" name="system.subjulgar" {{checked system.subjulgar}} />
        <span>{{localize "PYRO.Item.Subjulgar"}}</span></label>
    </div>
    {{/if}}
  </div>

  <div class="bloco">
    <h4 class="titulo-secao">{{localize "PYRO.Bloco.Escalonamentos"}}
      <button type="button" class="icone" data-action="adicionarScaling"
              title="{{localize 'PYRO.Item.AdicionarScaling'}}"><i class="fa-solid fa-plus"></i></button>
      {{#if podeRestaurarScalings}}
      <button type="button" class="icone" data-action="restaurarScalings"
              title="{{localize 'PYRO.Item.RestaurarScalings'}}"><i class="fa-solid fa-rotate-left"></i></button>
      {{/if}}
    </h4>

    {{#if system.scalings.length}}
    <div class="scaling-cabecalho">
      <span class="rotulo">{{localize "PYRO.Item.ScalingNome"}}</span>
      <span class="rotulo">{{localize "PYRO.Item.Base"}}</span>
      <span class="rotulo">{{localize "PYRO.Item.PorIntencao"}}</span>
      <span class="rotulo">{{localize "PYRO.Item.Faces"}}</span>
      <span></span>
    </div>
    {{#each system.scalings as |sc si|}}
    <div class="scaling-linha">
      <input type="text" name="system.scalings.{{si}}.nome" value="{{sc.nome}}"
             placeholder="{{localize 'PYRO.Item.ScalingPlaceholder'}}" />
      <input type="number" step="any" name="system.scalings.{{si}}.base" value="{{sc.base}}" />
      <input type="number" step="any" name="system.scalings.{{si}}.porIntencao" value="{{sc.porIntencao}}" />
      <input type="number" name="system.scalings.{{si}}.faces" value="{{sc.faces}}" min="0" />
      <button type="button" class="icone perigo" data-action="removerScaling" data-index="{{si}}"
              title="{{localize 'PYRO.Excluir'}}"><i class="fa-solid fa-xmark"></i></button>
    </div>
    {{/each}}

    {{#if previaScalings.length}}
    <div class="previa-scalings">
      <span class="rotulo">{{localize "PYRO.Item.PreviaIntencoes"}}</span>
      {{#if previaMult}}<span class="destaque-lingua">x{{previaMult}}</span>{{/if}}
      <table>
        <thead><tr><th></th>{{#each previaIntencoes as |n|}}<th class="numero">{{n}}</th>{{/each}}</tr></thead>
        <tbody>
          {{#each previaScalings as |p|}}
          <tr><td>{{p.nome}}</td>{{#each p.valores as |v|}}<td class="numero">{{v}}</td>{{/each}}</tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    {{/if}}
    {{else}}
    <p class="secao-vazia">{{localize "PYRO.Item.SemScalings"}}</p>
    {{/if}}
  </div>
{{/if}}

{{#if isCaminho}}
  <div class="bloco">
    <h4 class="titulo-secao">{{localize "PYRO.Bloco.Identificacao"}}</h4>
    <div class="grade-campos">
      {{#if ehRacial}}
      <label class="campo largo"><span class="rotulo">{{localize "PYRO.Item.Raca"}}</span>
        <select name="system.raca">{{selectOptions racaOpts selected=system.raca}}</select></label>
      {{#if pedeDetalhe}}
      <label class="campo cresce"><span class="rotulo">{{localize "PYRO.Item.RacaDetalhe"}}</span>
        <input type="text" name="system.racaDetalhe" value="{{system.racaDetalhe}}"
               placeholder="{{localize 'PYRO.Item.RacaDetalhePlaceholder'}}" /></label>
      {{/if}}
      {{#if ehPrimeiroRacial}}
      <label class="campo largo"><span class="rotulo">{{localize "PYRO.Tamanho"}}</span>
        <select name="system.tamanho">{{selectOptions tamanhoOpts selected=system.tamanho localize=true}}</select></label>
      {{!-- Massivo e colossal são faixas: o número diz quantos espaços a
            criatura ocupa, e é ele que vira o alcance dela. --}}
      {{#if pedeTamanhoExato}}
      <label class="campo"><span class="rotulo">{{localize "PYRO.Item.TamanhoExato"}}</span>
        <input type="number" name="system.tamanhoExato" value="{{system.tamanhoExato}}"
               min="{{tamanhoExatoMin}}" {{#if tamanhoExatoMax}}max="{{tamanhoExatoMax}}"{{/if}}
               title="{{localize 'PYRO.Item.TamanhoExatoDica'}}" /></label>
      {{/if}}
      {{/if}}
      {{else}}
      <label class="campo cresce"><span class="rotulo">{{localize "PYRO.Item.NomeCaminho"}}</span>
        <input type="text" name="system.nomeCaminho" value="{{system.nomeCaminho}}"
               placeholder="{{localize 'PYRO.Item.NomeCaminhoPlaceholder'}}" /></label>
      {{/if}}
      <label class="campo"><span class="rotulo">{{localize "PYRO.Item.Xp"}}</span>
        <input type="number" name="system.xp" value="{{system.xp}}" min="0" /></label>
    </div>
    {{!-- Custo de cada tier neste Caminho, já com a regra de progressão dele. --}}
    <p class="pyro-nota custos-tier">{{localize "PYRO.Item.CustoPorTier"}}
      {{#each system.custosPorTier as |c|}}<span class="custo-tier"><strong>T{{c.tier}}</strong> {{c.custo}}</span>{{/each}}
    </p>
  </div>

  {{#if system.usaMagia}}
  <div class="bloco">
    <h4 class="titulo-secao">{{localize "PYRO.Bloco.Magia"}}</h4>
    {{!-- Em raça pré-definida o potencial vem da tabela do mundo, então o
          campo aqui só repetiria uma configuração que o jogador não escolhe.
          Ele volta em caminho de profissão/classe, onde não há preset. --}}
    {{#if mostrarPotencial}}
    <div class="grade-campos">
      <label class="campo largo"><span class="rotulo">{{localize "PYRO.Item.Potencial"}}</span>
        <select name="system.potencial">{{selectOptions potencialOpts selected=system.potencial localize=true}}</select></label>
    </div>
    {{/if}}
    <div class="afinidades-lista">
      <span class="rotulo">{{localize "PYRO.Item.Afinidades"}}
        <button type="button" class="icone" data-action="adicionarAfinidade"
                title="{{localize 'PYRO.Item.AdicionarAfinidade'}}"><i class="fa-solid fa-plus"></i></button>
      </span>
      {{#each system.afinidades as |af ai|}}
      <div class="linha-afinidade">
        <select name="system.afinidades.{{ai}}.tipo">{{selectOptions @root.afinidadeOpts selected=af.tipo}}</select>
        <input type="text" name="system.afinidades.{{ai}}.outro" value="{{af.outro}}"
               placeholder="{{localize 'PYRO.AfinidadesPlaceholder'}}" {{#unless (pyroEhOutro af.tipo)}}hidden{{/unless}} />
        <button type="button" class="icone perigo" data-action="removerAfinidade" data-index="{{ai}}"
                title="{{localize 'PYRO.Excluir'}}"><i class="fa-solid fa-xmark"></i></button>
      </div>
      {{else}}
      <p class="pyro-aviso">{{localize "PYRO.Item.PrecisaAfinidade"}}</p>
      {{/each}}
    </div>
  </div>
  {{/if}}
{{/if}}

{{#if isMagia}}
  <div class="bloco">
    <h4 class="titulo-secao">{{localize "PYRO.Bloco.Regras"}}</h4>
    <label class="check-linha" title="{{localize 'PYRO.Magia.UsaDtDica'}}">
      <input type="checkbox" name="system.usaDt" {{checked system.usaDt}} />
      <span>{{localize "PYRO.Magia.UsaDt"}}</span></label>
  </div>

  {{> "pyro.progresso"}}
  <div class="bloco">
    <h4 class="titulo-secao">{{localize "PYRO.Item.RunasDaMagia"}}</h4>
    <p class="pyro-nota">{{localize "PYRO.Item.MagiaScalingsDica"}}</p>
    <div class="magia-runas">
      {{#each runasMagia as |r ri|}}
      <div class="runa-bloco">
        <div class="runa-cab"><strong>{{r.nome}}</strong>
          {{#if r.mostrarTipoDano}}
          <select class="mini-select" name="system.runas.{{ri}}.tipoDano"
                  title="{{localize 'PYRO.Item.TipoDano'}}">
            {{selectOptions r.tipoDanoOpts selected=r.tipoDanoSelecionado}}
          </select>
          {{/if}}
          {{#if r.mostrarSubjulgar}}
          <label class="check-linha"><input type="checkbox" name="system.runas.{{ri}}.subjulgar" {{checked r.subjulgar}} />
            <span>{{localize "PYRO.Item.SubjulgarCurto"}}</span></label>
          {{/if}}
          <button type="button" class="icone" data-action="adicionarScalingMagia" data-runa="{{ri}}"
                  title="{{localize 'PYRO.Item.AdicionarScaling'}}"><i class="fa-solid fa-plus"></i></button>
        </div>
        {{#if r.scalings.length}}
        <div class="scaling-cabecalho">
          <span class="rotulo">{{localize "PYRO.Item.ScalingNome"}}</span>
          <span class="rotulo">{{localize "PYRO.Item.Base"}}</span>
          <span class="rotulo">{{localize "PYRO.Item.PorIntencao"}}</span>
          <span class="rotulo">{{localize "PYRO.Item.Faces"}}</span>
          <span></span>
        </div>
        {{#each r.scalings as |sc si|}}
        <div class="scaling-linha">
          <input type="text" name="system.runas.{{ri}}.scalings.{{si}}.nome" value="{{sc.nome}}"
                 placeholder="{{localize 'PYRO.Item.ScalingPlaceholder'}}" />
          <input type="number" step="any" name="system.runas.{{ri}}.scalings.{{si}}.base" value="{{sc.base}}" />
          <input type="number" step="any" name="system.runas.{{ri}}.scalings.{{si}}.porIntencao" value="{{sc.porIntencao}}" />
          <input type="number" name="system.runas.{{ri}}.scalings.{{si}}.faces" value="{{sc.faces}}" min="0" />
          <button type="button" class="icone perigo" data-action="removerScalingMagia"
                  data-runa="{{ri}}" data-index="{{si}}"
                  title="{{localize 'PYRO.Excluir'}}"><i class="fa-solid fa-xmark"></i></button>
        </div>
        {{/each}}
        {{else}}
        <p class="pyro-nota">{{localize "PYRO.Item.MagiaSemCopia"}}</p>
        {{/if}}
      </div>
      {{/each}}
    </div>
  </div>
{{/if}}

{{#if mostrarPropriedades}}
  <div class="bloco">
    <h4 class="titulo-secao">{{localize "PYRO.Bloco.Propriedades"}}</h4>
    <div class="grade-campos">
      {{#if temPropriedadesFisicas}}
      <label class="campo"><span class="rotulo">{{localize "PYRO.Peso"}}</span>
        <input type="number" name="system.peso" value="{{system.peso}}" min="0" /></label>
      <label class="campo"><span class="rotulo">{{localize "PYRO.Item.Custo"}}</span>
        <input type="number" name="system.custo" value="{{system.custo}}" min="0" /></label>
      <label class="campo"><span class="rotulo">{{localize "PYRO.Quantidade"}}</span>
        <input type="number" name="system.quantidade" value="{{system.quantidade}}" min="0" /></label>
      {{/if}}
    </div>

    <div class="campos-check">
      {{#if isArma}}
      <label class="check-linha"><input type="checkbox" name="system.usaMunicao" {{checked system.usaMunicao}} />
        <span>{{localize "PYRO.Item.UsaMunicao"}}</span></label>
      <label class="check-linha" title="{{localize 'PYRO.Item.DesarmadoDica'}}">
        <input type="checkbox" name="system.desarmado" {{checked system.desarmado}} />
        <span>{{localize "PYRO.Item.Desarmado"}}</span></label>
      {{/if}}
      {{#if isEquipamento}}
      <label class="check-linha"><input type="checkbox" name="system.equipado" {{checked system.equipado}} />
        <span>{{localize "PYRO.Item.Equipado"}}</span></label>
      {{/if}}
      {{#if isConsumivel}}
      <label class="check-linha"><input type="checkbox" name="system.municao" {{checked system.municao}} />
        <span>{{localize "PYRO.Item.Municao"}}</span></label>
      {{#if system.municao}}
      <label class="check-linha"><input type="checkbox" name="system.equipado" {{checked system.equipado}} />
        <span>{{localize "PYRO.Item.Equipado"}}</span></label>
      {{/if}}
      {{/if}}
      {{#if isHabilidade}}
      <label class="check-linha"><input type="checkbox" name="system.ehBase" {{checked system.ehBase}} />
        <span>{{localize "PYRO.Item.EhBase"}}</span></label>
      {{#if mostrarAdormecida}}
      <label class="check-linha" title="{{localize 'PYRO.Regras.despertar.Dica'}}">
        <input type="checkbox" name="system.adormecida" {{checked system.adormecida}} />
        <span>{{localize "PYRO.Despertar.Adormecida"}}</span></label>
      {{/if}}
      {{#if rotuloAbaCaminho}}
      <label class="check-linha"><input type="checkbox" name="system.abaCaminho" {{checked system.abaCaminho}} />
        <span>{{rotuloAbaCaminho}}</span></label>
      {{/if}}
      {{/if}}
      {{#if isCaminho}}
      <label class="check-linha"><input type="checkbox" name="system.ehRacial" {{checked system.ehRacial}} />
        <span>{{localize "PYRO.Item.EhRacial"}}</span></label>
      {{#if mostrarChecksMagia}}
      <label class="check-linha"><input type="checkbox" name="system.usaMagia" {{checked system.usaMagia}} />
        <span>{{localize "PYRO.Item.UsaMagia"}}</span></label>
      <label class="check-linha"><input type="checkbox" name="system.usaFeiticaria" {{checked system.usaFeiticaria}} />
        <span>{{localize "PYRO.Item.UsaFeiticaria"}}</span></label>
      {{/if}}
      {{/if}}
    </div>

  </div>
{{/if}}
</section>
