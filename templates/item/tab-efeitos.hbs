<section class="tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">
  <div class="barra-acoes">
    <button type="button" class="botao-secao so-icone" data-action="criarEfeito"
            title="{{localize 'PYRO.Criar'}}">
      <i class="fa-solid fa-plus"></i>
    </button>
  </div>

  {{!-- Efeitos de uso: vão para o alvo pelo card do chat --}}
  <section class="secao">
    <header class="secao-topo">
      <h3 class="titulo-secao">{{localize "PYRO.Efeitos.SecaoUso"}}</h3>
      <span class="secao-contagem numero">{{efeitosDeUso.length}}</span>
    </header>
    {{#if efeitosDeUso.length}}
    <ol class="lista-itens">
      {{#each efeitosDeUso as |ef|}}
      {{> "pyro.efeito-linha" ef=ef}}
      {{/each}}
    </ol>
    {{else}}
    <p class="secao-vazia">{{localize "PYRO.Vazio.efeitosUso"}}</p>
    {{/if}}
  </section>

  {{!-- Efeitos passivos: valem enquanto o item estiver na ficha --}}
  <section class="secao">
    <header class="secao-topo">
      <h3 class="titulo-secao">{{localize "PYRO.Efeitos.SecaoPassivo"}}</h3>
      <span class="secao-contagem numero">{{efeitos.length}}</span>
    </header>
    {{#if efeitos.length}}
    <ol class="lista-itens">
      {{#each efeitos as |ef|}}
      {{> "pyro.efeito-linha" ef=ef}}
      {{/each}}
    </ol>
    {{else}}
    <p class="secao-vazia">{{localize "PYRO.Vazio.efeitosItem"}}</p>
    {{/if}}
  </section>

  {{!-- Fim da forma: o que a transformação cobra na volta. Os efeitos aqui
        esperam a forma acabar; o bloco de recursos é o que sai do personagem
        no mesmo instante. --}}
  {{#if ehTransformacao}}
  <section class="secao">
    <header class="secao-topo">
      <h3 class="titulo-secao">{{localize "PYRO.Efeitos.SecaoAoAcabar"}}</h3>
      <span class="secao-contagem numero">{{efeitosAoAcabar.length}}</span>
    </header>
    {{#if efeitosAoAcabar.length}}
    <ol class="lista-itens">
      {{#each efeitosAoAcabar as |ef|}}
      {{> "pyro.efeito-linha" ef=ef}}
      {{/each}}
    </ol>
    {{else}}
    <p class="secao-vazia">{{localize "PYRO.Vazio.efeitosAoAcabar"}}</p>
    {{/if}}

    <div class="bloco">
      <h4 class="titulo-secao">{{localize "PYRO.Transformacao.Fim.Recursos"}}</h4>
      <div class="grade-campos">
        {{#each camposDoFim as |c|}}
        <label class="campo"><span class="rotulo">{{c.label}}</span>
          <input type="text" name="{{c.nomeValor}}" value="{{c.valor}}"
                 placeholder="0" /></label>
        <label class="campo"><span class="rotulo">{{localize "PYRO.Transformacao.Fim.Modo"}}</span>
          <select name="{{c.nomeModo}}">{{selectOptions @root.modosDeGasto selected=c.modo localize=true}}</select></label>
        {{/each}}
      </div>
      {{pyroDica "PYRO.Transformacao.Fim.Dica"}}
    </div>
  </section>
  {{/if}}
</section>
