{
  "name": "pyro",
  "private": true,
  "type": "module",
  "description": "Ferramentas de build do sistema PYRO. Não é necessário para jogar: o Foundry lê packs/ pronto.",
  "scripts": {
    "gerar": "node tools/gerar-itens.mjs",
    "gerar:runas": "node tools/gerar-runas.mjs",
    "gerar:compendios": "node tools/gerar-compendios.mjs",
    "gerar:icones": "node tools/gerar-icones.mjs",
    "importar": "node tools/importar-mundo.mjs",
    "packs": "node tools/compilar-packs.mjs",
    "build": "npm run gerar && npm run gerar:runas && npm run gerar:compendios && npm run packs"
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^3.0.4",
    "@iconify-json/game-icons": "^1.2.4",
    "js-yaml": "^5.2.0"
  }
}
